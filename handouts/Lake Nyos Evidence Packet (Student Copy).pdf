endobj

160 0 obj
<</Type/StructElem/S/P/P 96 0 R/E(A Mystery at Lake Monoun)/Pg 13 0 R/K[2]>>
endobj

161 0 obj
<</Type/StructElem/S/P/P 96 0 R/E(BREAKING)/Pg 13 0 R/K[3]>>
endobj

162 0 obj
<</Type/StructElem/S/P/P 96 0 R/E(MONDAY, 20 AUG 1984)/Pg 13 0 R/K[4]>>
endobj

